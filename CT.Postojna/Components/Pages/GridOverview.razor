@page "/client/grid/overview"
@rendermode InteractiveServer
@using CT.Postojna.Models
@using CT.Postojna.Services
@inject ActivityService ActivityService
@inject ILogger<GridOverview> Logger

<PageTitle>Activities</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Activities</h1>
            <p class="text-body-secondary mb-0">Create, edit, and organize activities.</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="StartCreate">Add activity</button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-success" role="status">@statusMessage</div>
    }

    @if (isEditing)
    {
        <section class="card shadow-sm mb-4" aria-labelledby="activity-form-heading">
            <div class="card-header bg-body d-flex justify-content-between align-items-center">
                <h2 id="activity-form-heading" class="h5 mb-0">@(editActivity.Id == 0 ? "New activity" : "Edit activity")</h2>
                <button type="button" class="btn-close" aria-label="Close form" @onclick="CancelEdit"></button>
            </div>
            <div class="card-body">
                <EditForm Model="editActivity" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="activity-name">Name</label>
                            <InputText id="activity-name" class="form-control" @bind-Value="editActivity.Name" />
                            <ValidationMessage For="@(() => editActivity.Name)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="activity-category">Category</label>
                            <InputText id="activity-category" class="form-control" @bind-Value="editActivity.CategoryName" />
                            <ValidationMessage For="@(() => editActivity.CategoryName)" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="activity-category-id">Category ID (optional)</label>
                            <InputNumber id="activity-category-id" class="form-control" @bind-Value="editActivity.CategoryId" min="1" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label" for="activity-duration">Duration</label>
                            <InputText id="activity-duration" class="form-control" @bind-Value="editActivity.Duration" />
                            <ValidationMessage For="@(() => editActivity.Duration)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="activity-description">Description</label>
                            <InputTextArea id="activity-description" class="form-control" @bind-Value="editActivity.Description" />
                            <ValidationMessage For="@(() => editActivity.Description)" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="activity-notes">Additional details</label>
                            <InputTextArea id="activity-notes" class="form-control" @bind-Value="editActivity.AheadOfTimeGOAT" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">@(isSaving ? "Saving…" : "Save activity")</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@isSaving" @onclick="CancelEdit">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </section>
    }

    <section class="card shadow-sm">
        <div class="card-header bg-body d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="h5 mb-0">Activity list <span class="badge text-bg-secondary">@FilteredActivities.Count</span></h2>
            <input class="form-control" style="max-width: 20rem" type="search" placeholder="Search activities" aria-label="Search activities" @bind="searchText" @bind:event="oninput" />
        </div>
        @if (isLoading)
        {
            <div class="card-body text-body-secondary" role="status">Loading activities…</div>
        }
        else if (FilteredActivities.Count == 0)
        {
            <div class="card-body text-center py-5">
                <p class="h5">No activities found</p>
                <p class="text-body-secondary mb-3">Add an activity to get started, or try a different search.</p>
                <button type="button" class="btn btn-outline-primary" @onclick="StartCreate">Add activity</button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Name</th><th>Category</th><th>Description</th><th>Duration</th><th class="text-end">Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in FilteredActivities)
                        {
                            <tr @key="activity.Id">
                                <td class="fw-semibold">@activity.Name</td>
                                <td><span class="badge text-bg-light border">@activity.CategoryName</span></td>
                                <td>@activity.Description</td>
                                <td>@activity.Duration</td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" aria-label="Edit @activity.Name" @onclick="(() => StartEdit(activity))">Edit</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Delete @activity.Name" @onclick="(() => ConfirmDelete(activity))">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (activityToDelete is not null)
    {
        <div class="alert alert-warning mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
            <span>Delete <strong>@activityToDelete.Name</strong>? This cannot be undone.</span>
            <span class="text-nowrap">
                <button type="button" class="btn btn-sm btn-danger me-2" disabled="@isDeleting" @onclick="DeleteAsync">@(isDeleting ? "Deleting…" : "Confirm delete")</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@isDeleting" @onclick="CancelDelete">Cancel</button>
            </span>
        </div>
    }
</div>

@code {
    private List<Activity> activities = [];
    private Activity editActivity = new();
    private Activity? activityToDelete;
    private string searchText = string.Empty;
    private string? errorMessage;
    private string? statusMessage;
    private bool isLoading = true;
    private bool isEditing;
    private bool isSaving;
    private bool isDeleting;

    private List<Activity> FilteredActivities => activities
        .Where(activity => string.IsNullOrWhiteSpace(searchText)
            || $"{activity.Name} {activity.CategoryName} {activity.Description}".Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderBy(activity => activity.Name)
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            activities = await ActivityService.GetAllAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to load activity records.");
            errorMessage = "Could not load activities. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartCreate()
    {
        errorMessage = null;
        statusMessage = null;
        activityToDelete = null;
        editActivity = new Activity();
        isEditing = true;
    }

    private void StartEdit(Activity activity)
    {
        errorMessage = null;
        statusMessage = null;
        activityToDelete = null;
        editActivity = new Activity
        {
            Id = activity.Id,
            CategoryId = activity.CategoryId,
            CategoryName = activity.CategoryName,
            Name = activity.Name,
            Description = activity.Description,
            Duration = activity.Duration,
            AheadOfTimeGOAT = activity.AheadOfTimeGOAT,
            values = activity.values
        };
        isEditing = true;
    }

    private async Task SaveAsync()
    {
        isSaving = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            if (editActivity.Id == 0)
            {
                editActivity.Id = await ActivityService.CreateAsync(editActivity);
                activities.Add(editActivity);
                statusMessage = "Activity added.";
            }
            else if (await ActivityService.UpdateAsync(editActivity.Id, editActivity))
            {
                var index = activities.FindIndex(activity => activity.Id == editActivity.Id);
                if (index >= 0) activities[index] = editActivity;
                statusMessage = "Activity updated.";
            }
            else
            {
                errorMessage = "This activity no longer exists. Refresh the list and try again.";
                return;
            }
            isEditing = false;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to save activity record {ActivityId}.", editActivity.Id);
            errorMessage = "Could not save this activity. Please check the database connection and try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete(Activity activity)
    {
        errorMessage = null;
        statusMessage = null;
        isEditing = false;
        activityToDelete = activity;
    }

    private async Task DeleteAsync()
    {
        var deletedActivity = activityToDelete;
        if (deletedActivity is null) return;
        isDeleting = true;
        errorMessage = null;
        statusMessage = null;
        try
        {
            if (await ActivityService.DeleteAsync(deletedActivity.Id))
            {
                activities.RemoveAll(activity => activity.Id == deletedActivity.Id);
                statusMessage = "Activity deleted.";
                activityToDelete = null;
            }
            else
            {
                errorMessage = "This activity could not be found. Refresh the list and try again.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to delete activity record {ActivityId}.", deletedActivity.Id);
            errorMessage = "Could not delete this activity. Please check the database connection and try again.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void CancelEdit() => isEditing = false;
    private void CancelDelete() => activityToDelete = null;
}
