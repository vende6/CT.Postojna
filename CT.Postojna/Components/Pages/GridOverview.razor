@page "/client/grid/overview"
@using CT.Postojna.Models
@using CT.Postojna.Services

<PageTitle>Activities</PageTitle>

<h1>Activities</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Category</th>
            <th>Duration</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var activity in Activities)
        {
            <tr>
                <td>@activity.Id</td>
                <td>@activity.Name</td>
                <td>@activity.Description</td>
                <td>@activity.CategoryName</td>
                <td>@activity.Duration</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IEnumerable<Activity> Activities { get; set; } = [];

    protected override void OnInitialized()
    {
        Activities = ActivityService.GenerateActivities();
    }
}
