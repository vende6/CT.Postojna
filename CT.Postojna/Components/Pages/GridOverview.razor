@page "/client/grid/overview"
@using CT.Postojna.Models
@using CT.Postojna.Services

<PageTitle>Product Overview</PageTitle>

<h1>Product Overview</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Released</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in GridData)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price?.ToString("C2")</td>
                <td>@product.Quantity</td>
                <td>@product.Released?.ToString("d")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IEnumerable<Product> GridData { get; set; } = [];

    protected override void OnInitialized()
    {
        GridData = ProductService.GenerateProducts();
    }
}
