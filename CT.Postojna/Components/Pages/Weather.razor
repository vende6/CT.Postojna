@page "/weather"
@using CT.Postojna.Models
@using CT.Postojna.Services

<PageTitle>Staff</PageTitle>

<h1>Staff</h1>
<p>Staff records generated by the people service.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Nickname</th>
            <th>Age</th>
            <th>Nationality</th>
            <th>Bio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Staff)
        {
            <tr>
                <td>@person.FirstName @person.LastName</td>
                <td>@person.Nickname</td>
                <td>@person.Age</td>
                <td>@person.Nationality</td>
                <td>@person.Bio</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IEnumerable<Person> Staff { get; set; } = [];

    protected override void OnInitialized()
    {
        Staff = PersonService.GeneratePersons();
    }
}
