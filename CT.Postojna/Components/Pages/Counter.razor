@page "/counter"
@using CT.Postojna.Models
@using CT.Postojna.Services

<PageTitle>Immigrants</PageTitle>

<h1>Immigrants</h1>
<p>People registered with CT Postojna.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Citizenship</th>
            <th>Nationality</th>
            <th>Bio</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in Immigrants)
        {
            <tr>
                <td>@person.FirstName @person.LastName</td>
                <td>@person.Age</td>
                <td>@person.Citizenship</td>
                <td>@person.Nationality</td>
                <td>@person.Bio</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private IEnumerable<Person> Immigrants { get; set; } = [];

    protected override void OnInitialized()
    {
        Immigrants = PersonService.GeneratePersons();
    }
}
